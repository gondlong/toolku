# Salin ke .env lalu sesuaikan.
# SECRET_KEY wajib diganti (minimal 32 byte random).
SECRET_KEY=ganti-dengan-output-openssl-rand-hex-32

# Set 1 hanya jika aplikasi diakses lewat HTTPS (mengaktifkan Secure cookie).
TOOLKU_SECURE_COOKIES=0

# Port host untuk ToolKu (default 8000). Ubah kalau ada service lain di port itu.
TOOLKU_PORT=8000

# Bahasa yang di-load LibreTranslate.
# Default (bundle): en,zh,ar,ja,ko,id = Inggris, Mandarin, Arab, Jepang, Korea, Indonesia.
# Kosongkan untuk load semua bahasa (±100 bahasa, butuh ±4-6 GB RAM untuk model Argos).
LT_LOAD_ONLY=en,zh,ar,ja,ko,id
